APP_NAME=Amaliyot
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Set when a TLS proxy sits in front of nginx: "*" or comma-separated proxy IPs/CIDRs (docs/DEPLOYMENT.md §3).
TRUSTED_PROXIES=

APP_LOCALE=uz
APP_FALLBACK_LOCALE=uz
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5434
DB_DATABASE=internship
DB_USERNAME=internship
DB_PASSWORD=internship

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Redis carries cache, queue, and rate limits. Attendance lives only in PostgreSQL.
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

# predis works without a PHP extension. The Docker image uses phpredis.
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=16379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Telegram (student interface). Never commit real values.
# TELEGRAM_BOT_TOKEN comes from @BotFather. TELEGRAM_WEBHOOK_SECRET: 32+ random characters (A-Z a-z 0-9 _ -).
# TELEGRAM_BOT_USERNAME without "@", used to build invite links.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=
# TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_HTTP_TIMEOUT=10
# Minutes an unfinished bot dialog is kept.
# TELEGRAM_CONVERSATION_TTL=30
# true records outgoing messages instead of calling the Bot API (local demos without a bot).
TELEGRAM_FAKE=false

# Must stay above the longest queued job (CSV export, 600 s).
# REDIS_QUEUE_RETRY_AFTER=660

# First administrator, created or refreshed by `php artisan admin:ensure` (and by db:seed when set).
# The password is read from the environment only; it is stored hashed.
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_NAME=
ADMIN_EMAIL=
# Used only when the database has no university yet.
UNIVERSITY_NAME=
UNIVERSITY_TIMEZONE=Asia/Tashkent
